# ─── Local dev (npm run dev) ──────────────────────────────────────────────
# The Vite dev server proxies
#   /api/preaudit/*  -> $VITE_PREAUDIT_PROXY
#   /api/postaudit/* -> $VITE_POSTAUDIT_PROXY
# so the browser stays same-origin and we do not depend on each backend
# returning CORS headers.

# Pre-audit (Demo 1) — POST /v1/tx/preflight
VITE_PREAUDIT_PROXY=http://<host>:<port>

# Post-audit (Demo 2 / Demo 3) — POST /audit/from-tx | /audit/subject | /scenario/{id}
VITE_POSTAUDIT_PROXY=http://<host>:<port>


# ─── Production build (npm run build, e.g. GitHub Pages) ─────────────────
# Production has no dev proxy, so the bundle calls these URLs directly.
# Both backends MUST send Access-Control-Allow-Origin: * (or the Pages origin).
# When set, these override the /api/* proxy paths in src/api/*.ts.

# VITE_PREAUDIT_URL=http://<host>:<port>
# VITE_POSTAUDIT_URL=http://<host>:<port>
