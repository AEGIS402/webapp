# Audit backend deployments. The Vite dev server proxies
#   /api/preaudit/*  -> $VITE_PREAUDIT_PROXY
#   /api/postaudit/* -> $VITE_POSTAUDIT_PROXY
# so the browser stays same-origin and we do not depend on each backend
# returning CORS headers.
#
# Copy to .env (which is gitignored) and fill in the deployed URLs.

# Pre-audit (Demo 1) — POST /v1/tx/preflight
VITE_PREAUDIT_PROXY=http://<host>:<port>

# Post-audit (Demo 2) — POST /audit/from-tx | /audit/subject
VITE_POSTAUDIT_PROXY=http://<host>:<port>
